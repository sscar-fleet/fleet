{
  "expo": {
    "name": "SS CAR FLEET",
    "slug": "ss-car-fleet",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sscarsystem.fleet",
      "infoPlist": {
        "NSCameraUsageDescription": "L'appareil photo sert à photographier les véhicules, les papiers des clients et les avis d'amende.",
        "NSPhotoLibraryUsageDescription": "Vos photos servent à ajouter un papier ou une photo de véhicule déjà prise.",
        "NSLocationWhenInUseUsageDescription": "La position est enregistrée sur l'état des lieux pour prouver où le véhicule a été remis ou rendu.",
        "NSFaceIDUsageDescription": "Face ID vous évite de retaper votre mot de passe.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sscarsystem.fleet"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "L'appareil photo sert à photographier les véhicules, les papiers des clients et les avis d'amende."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La position est enregistrée sur l'état des lieux."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID vous évite de retaper votre mot de passe."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#000000",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#19f7d6"
        }
      ]
    ],
    "scheme": "sscarfleet",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    },
    "owner": "sscarfleet",
    "extra": {
      "eas": {
        "projectId": "e429f033-ea19-45f7-989f-bb4031bb043f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e429f033-ea19-45f7-989f-bb4031bb043f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
