# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Import de la flotte et lecture des papiers (Fleet AI)
ANTHROPIC_API_KEY=
# IMPORT_MODELE=claude-sonnet-5-5   (repli automatique sur LECTURE_MODELE si indisponible)

# Reconnaissance des clients SS CAR SYSTEM (base Airtable SS CARSYSTEM, jeton en lecture seule : data.records:read)
AIRTABLE_TOKEN=
# Clé serveur Supabase (rattachement des boîtiers des clients SS CAR SYSTEM)
SUPABASE_SERVICE_ROLE_KEY=

# Photos « catalogue » des véhicules (de profil, fond transparent) : Car Image API (carimage.dev)
# Gratuit = essai seulement ; formule payante obligatoire pour un usage commercial
# CAR_IMAGE_API_KEY=
